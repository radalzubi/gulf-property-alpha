# ───────────────────────────────────────────────────────────────────────────
# Gulf Property Alpha — environment variables
# Copy to `.env.local` (Next.js) and/or `.env` (scripts/worker).
# THE APP RUNS WITH ZERO CONFIG: with no DATABASE_URL it serves labeled
# SAMPLE data from an in-memory store. Missing credentials never crash it.
# ───────────────────────────────────────────────────────────────────────────

# ── Database (optional in dev) ───────────────────────────────────────────────
# Postgres + PostGIS connection string. On Supabase: Project → Settings →
# Database → Connection string (use the "Session"/pooler URI). When unset,
# the app uses the in-memory sample repository.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Which repository to use: "auto" (postgres if DATABASE_URL set, else memory),
# "memory", or "postgres".
DATA_BACKEND=auto

# Exclude rows flagged is_sample=true from production queries (true/false).
EXCLUDE_SAMPLE_DATA=false

# ── Real open-data connector (Dubai) ─────────────────────────────────────────
# Dubai Pulse / DLD publish open datasets. Base URL is configurable so the
# adapter can be pointed at the current open-data endpoint or a local mirror.
# Leave unset to keep the adapter in "not_configured" mode (no network calls).
# DLD_OPENDATA_BASE_URL=https://www.dubaipulse.gov.ae/dataset
# DLD_OPENDATA_TRANSACTIONS_URL=
# DLD_OPENDATA_RENTS_URL=

# ── Portal / commercial feeds (all optional; stubbed until provided) ─────────
# PROPERTY_FINDER_API_KEY=
# PROPERTY_FINDER_FEED_URL=
# BAYUT_API_KEY=
# BAYUT_FEED_URL=
# DUBIZZLE_API_KEY=
# DUBIZZLE_FEED_URL=

# ── Official gateways (optional; require licensed access) ────────────────────
# DLD_GATEWAY_API_KEY=
# DUBAI_REST_API_KEY=
# ADREC_API_KEY=
# DARI_API_KEY=

# ── Map (optional) ───────────────────────────────────────────────────────────
# MapLibre uses a free demo/OpenStreetMap style by default — no token needed.
# Set a custom style URL (e.g. MapTiler/Mapbox) to upgrade basemaps.
# NEXT_PUBLIC_MAP_STYLE_URL=

# ── Alert delivery (architecture only — no external sends without keys) ──────
# ALERT_EMAIL_FROM=
# SMTP_URL=
# ALERT_WEBHOOK_URL=
# WHATSAPP_API_TOKEN=

# ── Scheduler ────────────────────────────────────────────────────────────────
# Enable the in-process node-cron worker (true/false). On serverless hosts use
# Supabase pg_cron / Vercel Cron instead. Intervals auto-relax on free tiers.
ENABLE_SCHEDULER=false
