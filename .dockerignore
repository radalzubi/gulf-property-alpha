# Keep host build output and dependencies out of the image: the deps stage
# installs Linux node_modules, and `COPY . .` would otherwise replace them.
node_modules
.next
out
build
coverage
*.tsbuildinfo

# Secrets and local data never belong in the build context.
.env
.env*.local
*.pem
kaggle.json
data
*.csv

# Repo and editor metadata.
.git
.github
.DS_Store
npm-debug.log*
